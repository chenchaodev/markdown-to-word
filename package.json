{
  "name": "markdown-to-word",
  "version": "4.0.0",
  "private": true,
  "description": "Markdown 转 Word/PDF 等格式的 Windows 桌面工具",
  "license": "GPL-3.0",
  "author": "chenchaodev",
  "homepage": "https://github.com/chenchaodev/markdown-to-word#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenchaodev/markdown-to-word.git"
  },
  "bugs": {
    "url": "https://github.com/chenchaodev/markdown-to-word/issues"
  },
  "keywords": [
    "markdown",
    "docx",
    "word",
    "pdf",
    "markdown-to-word",
    "converter",
    "electron",
    "chinese",
    "offline",
    "typescript",
    "windows"
  ],
  "type": "module",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src/ test/ gates/ tools/ --cache --cache-strategy content --cache-location node_modules/.cache/eslint/.eslintcache",
    "build": "tsc && node tools/copy-renderer.mjs",
    "dev": "npm run build && electron .",
    "start": "node gates/smoke/check-build-fresh.mjs && electron .",
    "test": "npm run build && electron test/acceptance.mjs",
    "gen:fixtures": "node gates/fixtures/gen-fixtures.mjs",
    "check:fixtures": "node gates/fixtures/gen-fixtures.mjs --check",
    "test:smoke": "node gates/smoke/check-build-fresh.mjs && electron . --smoke",
    "ui:shots": "electron tools/visual-check.mjs",
    "icons": "node tools/svg-to-ico.mjs",
    "test:coverage": "npm run build && c8 --reporter=text --reporter=json-summary --reports-dir=output/coverage --temp-directory=.c8-tmp --all --include=\"dist/**\" --exclude=\"dist/renderer/**\" --exclude=\"dist/core/ipc-contract.js\" --exclude=\"dist/core/image/image-resolver.js\" --exclude=\"dist/core/preload-api.js\" --exclude=\"dist/main/ipc/types.js\" --exclude=\"dist/main/index.js\" --exclude=\"dist/main/preload.cjs\" --check-coverage --statements=90 --branches=85 --functions=90 --lines=90 electron test/acceptance.mjs",
    "check:coverage-zero": "node gates/probe/gate-probes/coverage-gate.mjs --zero",
    "check:coverage-zero:selftest": "node gates/probe/check-coverage-zero.selftest.mjs",
    "report:coverage-renderer": "node tools/renderer-coverage-report.mjs",
    "check:gates": "node gates/probe/check-gate-probes.mjs",
    "test:all": "npm run test && npm run test:smoke",
    "check:smoke-report": "node gates/smoke/smoke-report.mjs",
    "check:pack-size": "node gates/artifacts/pack-size.mjs",
    "collect:license-fulltext": "node gates/supply/supply/collect-license-fulltext.mjs",
    "check:contract": "node gates/repo/check-ci-contract.mjs",
    "check:contract:selftest": "node gates/repo/check-ci-contract.selftest.mjs",
    "check:boundary": "node gates/repo/check-import-boundary.mjs",
    "check:boundary:dist": "node gates/repo/check-import-boundary.mjs --src dist --flavor dist",
    "check:transform-dispatch": "node gates/repo/check-transform-dispatch.mjs",
    "check:transform-dispatch:selftest": "node gates/repo/check-transform-dispatch.selftest.mjs",
    "check:test-numbering": "node gates/repo/check-test-numbering.mjs",
    "check:test-numbering:selftest": "node gates/repo/check-test-numbering.selftest.mjs",
    "check:temp-cleanup": "node gates/repo/check-temp-cleanup.mjs",
    "check:temp-cleanup:selftest": "node gates/repo/check-temp-cleanup.selftest.mjs",
    "check:archive-index:selftest": "node gates/repo/gen-archive-index.selftest.mjs",
    "check:pinned-actions": "node gates/repo/check-pinned-actions.mjs",
    "check:docs": "node gates/repo/check-docs.mjs",
    "check:docs:selftest": "node gates/repo/check-docs.selftest.mjs",
    "check:changelog": "node gates/repo/check-changelog.mjs",
    "check:changelog:selftest": "node gates/repo/check-changelog.selftest.mjs",
    "check:release-notes": "node gates/repo/check-release-notes.mjs",
    "check:release-notes:selftest": "node gates/repo/release-notes.selftest.mjs",
    "check:archive-index": "node gates/repo/gen-archive-index.mjs --check",
    "gen:archive-index": "node gates/repo/gen-archive-index.mjs",
    "check:env": "node gates/repo/print-env-fingerprint.mjs",
    "check:geometry": "electron gates/geometry/check-geometry.mjs",
    "gen:dist-manifest": "node gates/artifacts/check-dist-manifest.mjs",
    "check:dist-manifest": "node gates/artifacts/check-dist-manifest.mjs --check",
    "check:asar": "node gates/artifacts/check-asar-manifest.mjs",
    "check:release": "node gates/artifacts/check-release-artifacts.mjs",
    "check:signature": "node gates/artifacts/check-signature-status.mjs",
    "check:supply": "node gates/supply/supply/check-supply-chain.mjs",
    "gen:sbom": "node gates/supply/supply/gen-sbom.mjs",
    "check:sbom": "node gates/supply/supply/gen-sbom.mjs --check",
    "gen:licenses": "node gates/supply/supply/gen-licenses.mjs",
    "check:sca": "node gates/supply/supply/sca-audit.mjs",
    "check:unpacked-smoke": "node gates/artifacts/check-unpacked-smoke.mjs",
    "check:install-smoke": "node gates/artifacts/check-install-smoke.mjs",
    "clean:dist": "node gates/artifacts/clean-artifacts.mjs --target dist",
    "clean:release": "node gates/artifacts/clean-artifacts.mjs --target release",
    "verify:ci": "npm run check:contract && npm run check:contract:selftest && npm run check:boundary && npm run check:copy-sites && npm run check:copy-sites:selftest && npm run check:transform-dispatch && npm run check:transform-dispatch:selftest && npm run check:test-numbering && npm run check:test-numbering:selftest && npm run check:temp-cleanup && npm run check:temp-cleanup:selftest && npm run check:pinned-actions && npm run check:archive-index && npm run check:archive-index:selftest && npm run check:docs && npm run check:docs:selftest && npm run check:changelog && npm run check:release-notes && npm run check:release-notes:selftest && npm run check:changelog:selftest && npm run build && npm run check:boundary:dist && npm run typecheck && npm run lint && npm run test:coverage && npm run check:coverage-zero && npm run check:coverage-zero:selftest && npm run check:fixtures && npm run test:smoke && npm run check:geometry",
    "verify:release": "npm run verify:ci && npm run dist",
    "dist": "npm run clean:dist && npm run clean:release && npm run build && npm run gen:dist-manifest && electron-builder --win nsis --x64 --publish never && npm run check:dist-manifest && npm run check:asar && npm run check:release && npm run check:signature && npm run check:unpacked-smoke",
    "check:copy-sites": "node gates/repo/check-copy-sites.mjs",
    "check:copy-sites:selftest": "node gates/repo/check-copy-sites.selftest.mjs"
  },
  "build": {
    "appId": "com.markdown.tools.m2w",
    "productName": "MarkdownToWord",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "!dist/**/*.map",
      "package.json",
      "!node_modules/highlight.js/styles/**",
      "!node_modules/**/*.map"
    ],
    "extraFiles": [
      {
        "from": "build-assets/m2w.cmd",
        "to": "m2w.cmd"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "electronLanguages": [
        "zh-CN",
        "en-US"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "include": "build-assets/installer.nsh"
    }
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.1.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "c8": "^12.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "@mdit/plugin-footnote": "^1.0.2",
    "@mdit/plugin-katex": "^1.0.2",
    "@mdit/plugin-tasklist": "^1.0.2",
    "docx": "^9.7.1",
    "highlight.js": "^11.11.1",
    "iconv-lite": "^0.7.3",
    "jszip": "^3.10.1",
    "katex": "^0.18.1",
    "markdown-it": "^14.3.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.16.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-util-symbol": "2.0.1",
    "micromark-util-types": "2.0.2",
    "pdf-lib": "^1.17.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  }
}
