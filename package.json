{
  "name": "markdown-to-word",
  "version": "0.5.1",
  "private": true,
  "description": "Markdown 转 Word/PDF 等格式的 Windows 桌面工具",
  "type": "module",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts/copy-renderer.mjs",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "com.markdown.tools.m2w",
    "productName": "MarkdownToWord",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json",
      "!node_modules/highlight.js/styles/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "electronLanguages": [
        "zh-CN",
        "en-US"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@mdit/plugin-footnote": "^1.0.2",
    "@mdit/plugin-katex": "^1.0.2",
    "@mdit/plugin-tasklist": "^1.0.2",
    "docx": "^9.7.1",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.3.0",
    "pdf-lib": "^1.17.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  }
}
