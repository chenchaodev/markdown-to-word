{
  "name": "markdown-to-word",
  "version": "3.13.0",
  "private": true,
  "description": "Markdown 转 Word/PDF 等格式的 Windows 桌面工具",
  "license": "GPL-3.0",
  "author": "chenchaodev",
  "homepage": "https://github.com/chenchaodev/markdown-to-word#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenchaodev/markdown-to-word.git"
  },
  "bugs": {
    "url": "https://github.com/chenchaodev/markdown-to-word/issues"
  },
  "keywords": [
    "markdown",
    "docx",
    "word",
    "pdf",
    "markdown-to-word",
    "converter",
    "electron",
    "chinese",
    "offline",
    "typescript",
    "windows"
  ],
  "type": "module",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src/ test/ scripts/",
    "build": "tsc && node scripts/copy-renderer.mjs",
    "dev": "npm run build && electron .",
    "start": "node scripts/check-build-fresh.mjs && electron .",
    "test": "npm run build && electron test/acceptance.mjs",
    "gen:fixtures": "node test/tools/gen-fixtures.mjs",
    "check:fixtures": "node test/tools/gen-fixtures.mjs --check",
    "test:smoke": "node scripts/check-build-fresh.mjs && electron . --smoke",
    "ui:shots": "electron test/tools/visual-check.mjs",
    "icons": "node scripts/svg-to-ico.mjs",
    "test:coverage": "npm run build && c8 --reporter=text --reporter=json-summary --all --include=\"dist/**\" --exclude=\"dist/renderer/**\" --exclude=\"dist/core/ipc-contract.js\" --exclude=\"dist/core/image/image-resolver.js\" --exclude=\"dist/core/markdown/mermaid.js\" --exclude=\"dist/main/ipc/types.js\" --exclude=\"dist/main/index.js\" --exclude=\"dist/main/preload.cjs\" --check-coverage --statements=90 --branches=85 --functions=90 --lines=90 electron test/acceptance.mjs",
    "check:coverage-zero": "node scripts/gate-probes/coverage-gate.mjs --zero",
    "check:gates": "node scripts/check-gate-probes.mjs",
    "test:all": "npm run test && npm run test:smoke",
    "check:smoke-report": "node scripts/smoke-report.mjs",
    "check:pack-size": "node scripts/pack-size.mjs",
    "collect:license-fulltext": "node scripts/supply/collect-license-fulltext.mjs",
    "check:contract": "node scripts/check-ci-contract.mjs",
    "check:contract:selftest": "node scripts/check-ci-contract.selftest.mjs",
    "check:boundary": "node scripts/check-import-boundary.mjs",
    "check:pinned-actions": "node scripts/check-pinned-actions.mjs",
    "check:env": "node scripts/print-env-fingerprint.mjs",
    "check:geometry": "electron scripts/check-geometry.mjs",
    "gen:dist-manifest": "node scripts/check-dist-manifest.mjs",
    "check:dist-manifest": "node scripts/check-dist-manifest.mjs --check",
    "check:asar": "node scripts/check-asar-manifest.mjs",
    "check:release": "node scripts/check-release-artifacts.mjs",
    "check:signature": "node scripts/check-signature-status.mjs",
    "check:supply": "node scripts/supply/check-supply-chain.mjs",
    "gen:sbom": "node scripts/supply/gen-sbom.mjs",
    "check:sbom": "node scripts/supply/gen-sbom.mjs --check",
    "gen:licenses": "node scripts/supply/gen-licenses.mjs",
    "check:sca": "node scripts/supply/sca-audit.mjs",
    "check:unpacked-smoke": "node scripts/check-unpacked-smoke.mjs",
    "check:install-smoke": "node scripts/check-install-smoke.mjs",
    "clean:dist": "node scripts/clean-artifacts.mjs --target dist",
    "clean:release": "node scripts/clean-artifacts.mjs --target release",
    "verify:ci": "npm run check:contract && npm run check:contract:selftest && npm run check:boundary && npm run check:pinned-actions && npm run build && npm run typecheck && npm run lint && npm run test && npm run test:coverage && npm run check:coverage-zero && npm run check:fixtures && npm run test:smoke && npm run check:geometry",
    "verify:release": "npm run verify:ci && npm run dist",
    "dist": "npm run clean:dist && npm run clean:release && npm run build && npm run gen:dist-manifest && electron-builder --win nsis --x64 --publish never && npm run check:dist-manifest && npm run check:asar && npm run check:release && npm run check:signature && npm run check:unpacked-smoke"
  },
  "build": {
    "appId": "com.markdown.tools.m2w",
    "productName": "MarkdownToWord",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json",
      "!node_modules/highlight.js/styles/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "electronLanguages": [
        "zh-CN",
        "en-US"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.1.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "c8": "^12.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "@mdit/plugin-footnote": "^1.0.2",
    "@mdit/plugin-katex": "^1.0.2",
    "@mdit/plugin-tasklist": "^1.0.2",
    "docx": "^9.7.1",
    "highlight.js": "^11.11.1",
    "iconv-lite": "^0.7.3",
    "jszip": "^3.10.1",
    "katex": "^0.18.1",
    "markdown-it": "^14.3.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.16.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-util-symbol": "2.0.1",
    "micromark-util-types": "2.0.2",
    "pdf-lib": "^1.17.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  }
}
