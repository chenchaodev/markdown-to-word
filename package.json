{
  "name": "markdown-to-word",
  "version": "1.2.0",
  "private": true,
  "description": "Markdown 转 Word/PDF 等格式的 Windows 桌面工具",
  "license": "GPL-3.0",
  "type": "module",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ test/ scripts/",
    "build": "tsc && node scripts/copy-renderer.mjs",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "test": "npm run build && electron test/acceptance.mjs",
    "gen:fixtures": "node test/tools/gen-fixtures.mjs",
    "check:fixtures": "node test/tools/gen-fixtures.mjs --check",
    "test:smoke": "node scripts/check-build-fresh.mjs && electron . --smoke",
    "icons": "node scripts/svg-to-ico.mjs",
    "test:coverage": "npm run build && c8 --reporter=text --include=\"dist/**\" electron test/acceptance.mjs",
    "test:all": "npm run test && npm run test:smoke",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "com.markdown.tools.m2w",
    "productName": "MarkdownToWord",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json",
      "!node_modules/highlight.js/styles/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "electronLanguages": [
        "zh-CN",
        "en-US"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.1.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "c8": "^12.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "jszip": "^3.10.1",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "@mdit/plugin-footnote": "^1.0.2",
    "@mdit/plugin-katex": "^1.0.2",
    "@mdit/plugin-tasklist": "^1.0.2",
    "docx": "^9.7.1",
    "highlight.js": "^11.11.1",
    "iconv-lite": "^0.7.3",
    "katex": "^0.18.1",
    "markdown-it": "^14.3.0",
    "mermaid": "11.16.1",
    "pdf-lib": "^1.17.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  }
}
